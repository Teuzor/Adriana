<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PainelController">
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Gerenciamento: Painel">
            <font><Font name="System Bold" size="22.0" /></font>
        </Label>

        <VBox layoutX="30.0" layoutY="70.0" prefHeight="173.0" prefWidth="186.0" spacing="10.0">
            <children>
                <Label text="Textura de Fundo:" />
                <TextField fx:id="txtTextura" prefWidth="250.0" />

                <Label text="Quantidade de Itens:" />
                <TextField fx:id="txtQtdItens" prefWidth="250.0" />

                <CheckBox fx:id="chkFixado" text="Fixado na Parede" />

                <HBox spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#cadastrar" style="-fx-background-color: #90D5FF;" text="Cadastrar" />
                        <Button mnemonicParsing="false" onAction="#voltar" style="-fx-background-color: #ff6961;" text="Voltar" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <TextArea fx:id="txtAreaLista" editable="false" layoutX="234.0" layoutY="96.0" prefHeight="268.0" prefWidth="230.0" promptText="Dados salvos no banco aparecerão aqui..." />

        <TextField fx:id="txtDeletar" layoutX="471.0" layoutY="96.0" prefHeight="26.0" prefWidth="122.0" promptText="Textura para deletar...">
            <font><Font size="11.0" /></font>
        </TextField>
        <Button layoutX="471.0" layoutY="129.0" mnemonicParsing="false" onAction="#deletar" prefHeight="26.0" prefWidth="122.0" style="-fx-background-color: #ff9999;" text="Deletar" />
    </children>
</AnchorPane>