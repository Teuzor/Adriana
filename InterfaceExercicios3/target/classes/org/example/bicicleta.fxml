<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="550.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.BicicletaController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <top>
        <Label text="Gerenciamento: Bicicleta" BorderPane.alignment="CENTER_LEFT">
            <font><Font name="System Bold" size="26.0" /></font>
            <BorderPane.margin><Insets bottom="18.0" /></BorderPane.margin>
        </Label>
    </top>
    <center>
        <HBox spacing="25.0">
            <children>
                <VBox prefWidth="250.0" spacing="12.0">
                    <children>
                        <Label text="Modelo:"><font><Font size="14.0" /></font></Label>
                        <TextField fx:id="txtModelo" prefHeight="34.0" />

                        <Label text="Marcha Atual:"><font><Font size="14.0" /></font></Label>
                        <TextField fx:id="txtMarcha" prefHeight="34.0" />

                        <Label text="Velocidade (km/h):"><font><Font size="14.0" /></font></Label>
                        <TextField fx:id="txtVelocidade" prefHeight="34.0" />

                        <HBox spacing="12.0">
                            <VBox.margin><Insets top="12.0" /></VBox.margin>
                            <children>
                                <Button mnemonicParsing="false" onAction="#cadastrar" prefHeight="38.0" prefWidth="118.0" style="-fx-background-color: #90D5FF; -fx-cursor: hand;" text="Cadastrar">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#voltar" prefHeight="38.0" prefWidth="118.0" style="-fx-background-color: #ff6961; -fx-cursor: hand;" text="Voltar">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tabelaBicicletas" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colModelo" prefWidth="220.0" text="Modelo" />
                                <TableColumn fx:id="colMarcha" prefWidth="120.0" text="Marcha Atual" />
                                <TableColumn fx:id="colVelocidade" prefWidth="150.0" text="Velocidade (km/h)" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <TextField fx:id="txtDeletar" prefHeight="36.0" prefWidth="220.0" promptText="Modelo para deletar...">
                                    <font><Font size="13.0" /></font>
                                </TextField>
                                <Button mnemonicParsing="false" onAction="#deletar" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #ff9999; -fx-cursor: hand;" text="Deletar">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>